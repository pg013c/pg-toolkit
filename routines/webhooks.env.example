# Copy to ~/.config/daily-news/webhooks.env and chmod 600. Never commit the real file.
# Each URL comes from a Slack app's Incoming Webhooks page and posts to one channel.

# Channel for the daily AI digest (routines/daily-ai-news).
SLACK_WEBHOOK_AI=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Channel for the daily home country and world digest (routines/daily-news).
SLACK_WEBHOOK_NEWS=https://hooks.slack.com/services/XXX/YYY/ZZZ
